module webserver

; A minimal HTTP server on port 8200. Accepts connections forever and
; replies "Hi" to every request. Uses only the syscall instruction
; (socket_create/bind/listen/accept/recv/send/close) - no native codegen
; support for sockets yet, so this must run under the interpreter:
;
;   uasm compile examples/webserver.uasm -o webserver.uo
;   uasm run webserver.uo &
;   curl http://localhost:8200/
;   kill %1

export func main() -> i32 {
entry:
    mov.ptr r0, 200
    mov.i32 r1, 72
    store.i8 r0, r1
    mov.ptr r0, 201
    mov.i32 r1, 84
    store.i8 r0, r1
    mov.ptr r0, 202
    mov.i32 r1, 84
    store.i8 r0, r1
    mov.ptr r0, 203
    mov.i32 r1, 80
    store.i8 r0, r1
    mov.ptr r0, 204
    mov.i32 r1, 47
    store.i8 r0, r1
    mov.ptr r0, 205
    mov.i32 r1, 49
    store.i8 r0, r1
    mov.ptr r0, 206
    mov.i32 r1, 46
    store.i8 r0, r1
    mov.ptr r0, 207
    mov.i32 r1, 49
    store.i8 r0, r1
    mov.ptr r0, 208
    mov.i32 r1, 32
    store.i8 r0, r1
    mov.ptr r0, 209
    mov.i32 r1, 50
    store.i8 r0, r1
    mov.ptr r0, 210
    mov.i32 r1, 48
    store.i8 r0, r1
    mov.ptr r0, 211
    mov.i32 r1, 48
    store.i8 r0, r1
    mov.ptr r0, 212
    mov.i32 r1, 32
    store.i8 r0, r1
    mov.ptr r0, 213
    mov.i32 r1, 79
    store.i8 r0, r1
    mov.ptr r0, 214
    mov.i32 r1, 75
    store.i8 r0, r1
    mov.ptr r0, 215
    mov.i32 r1, 13
    store.i8 r0, r1
    mov.ptr r0, 216
    mov.i32 r1, 10
    store.i8 r0, r1
    mov.ptr r0, 217
    mov.i32 r1, 13
    store.i8 r0, r1
    mov.ptr r0, 218
    mov.i32 r1, 10
    store.i8 r0, r1
    mov.ptr r0, 219
    mov.i32 r1, 72
    store.i8 r0, r1
    mov.ptr r0, 220
    mov.i32 r1, 105
    store.i8 r0, r1

    mov.ptr r2, 250
    mov.i32 r3, 0
    store.i8 r2, r3

    mov.i64 r4, 2
    mov.i64 r5, 1
    syscall.i64 r6, 48, r4, r5

    mov.ptr r7, 250
    mov.i64 r8, 8200
    syscall.i64 r9, 50, r6, r7, r8

    mov.i64 r10, 1
    syscall.i64 r11, 51, r6, r10

    jmp acceptloop
acceptloop:
    syscall.i64 r12, 52, r6

    mov.ptr r13, 300
    mov.i64 r14, 512
    syscall.i64 r15, 54, r12, r13, r14

    mov.ptr r16, 200
    mov.i64 r17, 21
    syscall.i64 r18, 53, r12, r16, r17

    syscall.i64 r19, 55, r12

    jmp acceptloop
}
